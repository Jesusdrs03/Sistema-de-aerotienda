# ===== Firebase (cliente) - Consola Firebase > Configuración del proyecto > Tus apps > Web =====
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCJPS5oFt8EuVFneUoA9ywQ3u63GvyC0D8
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=aerotienda-c4752.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aerotienda-c4752
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=aerotienda-c4752.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=586976422787
NEXT_PUBLIC_FIREBASE_APP_ID=1:586976422787:web:d7e31f68aebfb8616c24b6

# ===== Firebase Admin (servidor) - Configuración > Cuentas de servicio > Generar clave privada =====
# Opción recomendada: pegar el contenido COMPLETO del archivo .json descargado
FIREBASE_SERVICE_ACCOUNT=
# Alternativa: las 3 variables separadas
FIREBASE_PROJECT_ID=aerotienda-c4752
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@aerotienda-c4752.iam.gserviceaccount.com
# Pegar la clave completa entre comillas, con los \n tal como vienen en el JSON
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ===== App =====
NEXT_PUBLIC_APP_NAME=Aerotienda
NEXT_PUBLIC_APP_URL=https://tu-app.vercel.app
# Canal por defecto en el formulario: sms | whatsapp | whatsapp_sms (WhatsApp y si falla SMS) | ambos
NEXT_PUBLIC_DEFAULT_CHANNEL=sms

# ===== Twilio (SMS / WhatsApp) - https://console.twilio.com =====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numero Twilio para SMS (formato +1XXXXXXXXXX) o, en su lugar, un Messaging Service SID (MGxxxx)
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Numero de WhatsApp Business aprobado en Twilio (formato +58XXXXXXXXXX o +1XXXXXXXXXX)
TWILIO_WHATSAPP_FROM=
# Plantillas aprobadas de WhatsApp (Content SID HXxxxx). Variables: {{1}} nombre, {{2}} numero pedido, {{3}} sede
TWILIO_WA_TEMPLATE_REGISTRO=
TWILIO_WA_TEMPLATE_LLEGADA=
TWILIO_WA_TEMPLATE_ENTREGA=

# ===== Solo desarrollo local con Firebase Emulator =====
# NEXT_PUBLIC_USE_EMULATOR=true
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
